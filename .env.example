# Copy this file to .env and add your local configuration.
APP_NAME=Voker Agent API
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Required to run the agent. Create this in the OpenRouter dashboard.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_HTTP_REFERER=http://localhost:8000

# Required to send traces to Voker. Copy this from the Voker setup page.
VOKER_API_KEY=
VOKER_AGENT_NAME=imperfect-operations-agent

# Voker Voice dashboard authentication. Register the API callback URL at Google,
# then set DASHBOARD_URL to the browser origin that should receive the login redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
DASHBOARD_URL=http://localhost:5173
RECORDING_RETENTION_DAYS=30
