# LiveKit room/worker credentials
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Voice-agent runtime: Deepgram speech and direct DeepSeek LLM

DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-asteria-en
DEEPSEEK_API_KEY=
DEEPSEEK_RUNTIME_MODEL=deepseek-flash

# Voker Voice telemetry destination. Create this key in the Voker Voice dashboard
# or with `voker-voice-api create-ingest-key`; it is not a LiveKit or DeepSeek key.
VOKER_API_KEY=
VOKER_VOICE_ENDPOINT=http://127.0.0.1:8001
VOKER_VOICE_ENABLED=true

# The worker exposes a health endpoint at http://127.0.0.1:8080/.
VOICE_DEMO_HOST=127.0.0.1
VOICE_DEMO_PORT=8080
VOICE_DEMO_VERSION=demo-1
