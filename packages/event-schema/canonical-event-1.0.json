{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voker.ai/schemas/voice/canonical-event-1.0.json",
  "title": "Voker Voice Canonical Event 1.0",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "external_session_id", "trace_id"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "event_type": { "type": "string", "minLength": 1, "maxLength": 128 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "sequence": { "type": ["integer", "null"], "minimum": 0 },
    "external_session_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "trace_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "span_id": { "type": ["string", "null"], "maxLength": 64 },
    "parent_span_id": { "type": ["string", "null"], "maxLength": 64 },
    "turn_id": { "type": ["string", "null"], "maxLength": 64 },
    "agent_run_id": { "type": ["string", "null"], "maxLength": 64 },
    "parent_agent_run_id": { "type": ["string", "null"], "maxLength": 64 },
    "agent": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"], "maxLength": 255 },
        "version": { "type": ["string", "null"], "maxLength": 255 }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "integration": { "type": ["string", "null"], "maxLength": 64 },
        "provider": { "type": ["string", "null"], "maxLength": 64 },
        "sdk": { "type": ["string", "null"], "maxLength": 128 },
        "sdk_version": { "type": ["string", "null"], "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "status": { "enum": ["unset", "ok", "error", "cancelled", "timeout"] },
    "duration_ms": { "type": ["number", "null"], "minimum": 0 },
    "attributes": { "type": "object" },
    "input": { "type": ["object", "null"] },
    "output": { "type": ["object", "null"] },
    "usage": { "type": ["object", "null"] },
    "error": { "type": ["object", "null"] }
  },
  "additionalProperties": false
}
